# ============================================================
# SecureForge — Environment Configuration Template
# ============================================================
# Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# This file is safe to commit — it contains only placeholders.
# Your actual .env file is excluded via .gitignore.
#
# Generating strong values:
#   openssl rand -hex 32        → use for API_KEY
#   openssl rand -base64 32     → use for passwords and NEXTAUTH_SECRET
# ============================================================


# ============================================================
# SECTION 1 — API & AUTH  (REQUIRED)
# ============================================================

# API_KEY
# Purpose   : Bearer token required by every REST API request.
#             The frontend and any external API clients must include this
#             value in the Authorization header: "Bearer <API_KEY>".
# Generate  : openssl rand -hex 32
# Must match: dashboard container (both services read the same .env value)
# Rotate    : Rotating this value immediately invalidates all existing clients
#             until they are updated. Rebuild containers after changing.
# Required  : Yes
API_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

# NEXTAUTH_SECRET
# Purpose   : Used by NextAuth.js to sign and verify session JWTs in the
#             frontend. Without this, all dashboard logins will fail.
# Generate  : openssl rand -base64 32
# Must match: The SAME value must be present in the dashboard container.
#             This is automatically handled since both services read this .env.
# Required  : Yes
NEXTAUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32


# ============================================================
# SECTION 2 — DASHBOARD LOGIN CREDENTIALS  (REQUIRED)
# ============================================================

# ADMIN_PASSWORD / OPERATOR_PASSWORD
# Purpose   : Username/password pairs that gate access to the SecureForge
#             dashboard UI. Admin has full access; Operator is read-only.
# Generate  : openssl rand -base64 32
# Note      : These are NOT PostgreSQL passwords. They are application-level
#             credentials checked by the BAS engine on login.
# Required  : Yes (both)
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
OPERATOR_PASSWORD=REPLACE_WITH_STRONG_OPERATOR_PASSWORD


# ============================================================
# SECTION 3 — POSTGRESQL DATABASE  (REQUIRED)
# ============================================================

# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# Purpose   : Credentials used when PostgreSQL initializes the database on
#             first launch. The BAS engine and Celery worker connect using
#             these values automatically via DATABASE_URL in docker-compose.yml.
# Generate  : openssl rand -base64 32  (for the password)
# Must match: docker-compose.yml reads these variables directly via
#             ${POSTGRES_USER}, ${POSTGRES_PASSWORD}, ${POSTGRES_DB}.
#             You do NOT need to edit docker-compose.yml separately.
# WARNING   : Changing POSTGRES_PASSWORD after the database volume has been
#             created requires deleting the volume and re-initializing:
#               docker compose down -v && docker compose up -d
# Required  : Yes
POSTGRES_USER=secureforge
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=secureforge


# ============================================================
# SECTION 4 — REDIS BROKER  (REQUIRED)
# ============================================================

# REDIS_PASSWORD
# Purpose   : Authentication password for the Redis message broker used by
#             Celery to queue and dispatch attack simulation tasks.
# Generate  : openssl rand -base64 32
# Must match: The Redis container in docker-compose.yml is currently started
#             WITHOUT --requirepass (no auth by default in this config).
#             If you enable Redis auth, you must update the redis service
#             command in docker-compose.yml to add: --requirepass ${REDIS_PASSWORD}
#             and update REDIS_URL to: redis://:${REDIS_PASSWORD}@redis:6379/0
# Required  : Yes (set a value now; activate in docker-compose if needed)
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD


# ============================================================
# SECTION 5 — ELASTICSEARCH  (REQUIRED)
# ============================================================

# ELASTIC_PASSWORD
# Purpose   : Password for the built-in Elasticsearch `elastic` superuser.
# Generate  : openssl rand -base64 32
# Important : In docker-compose.yml, xpack.security.enabled is currently set
#             to FALSE, which means Elasticsearch runs without authentication.
#             ELASTIC_PASSWORD is only enforced when you enable xpack security:
#               xpack.security.enabled=true
#             For production deployments, enable xpack security and set this value.
# Required  : Yes (for production) / Not enforced in default dev config
ELASTIC_PASSWORD=REPLACE_WITH_STRONG_ELASTIC_PASSWORD


# ============================================================
# SECTION 6 — DEPLOYMENT URLs  (OPTIONAL — defaults shown)
# ============================================================

# NEXTAUTH_URL
# Purpose   : The canonical public URL of the NextAuth frontend.
#             Must match the URL users type in their browser.
# Default   : http://localhost:3001
# Change to : Your public domain when deploying to production, e.g.:
#             https://secureforge.yourdomain.com
NEXTAUTH_URL=http://localhost:3001

# NEXT_PUBLIC_API_URL
# Purpose   : The URL the browser uses to reach the BAS Engine REST API.
#             This is a public variable embedded in the Next.js build.
# Default   : http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ENVIRONMENT
# Purpose   : Controls logging verbosity and error detail level.
#             Set to "development" locally for detailed tracebacks.
# Values    : production | development
ENVIRONMENT=production


# ============================================================
# SECTION 7 — LAB TARGETS  (OPTIONAL)
# ============================================================

# LAB_TARGETS
# Purpose   : Comma-separated list of private IP addresses that are
#             explicitly allowed to be targeted by attack simulations.
#             These bypass the built-in SSRF protection which blocks
#             requests to RFC-1918 (private) address ranges by default.
# Example   : LAB_TARGETS=192.168.56.101,192.168.56.102,10.0.0.5
# WARNING   : NEVER add production server IPs here. Only use isolated
#             lab VMs (e.g., DVWA, Juice Shop, Metasploitable).
LAB_TARGETS=


# ============================================================
# SECTION 8 — SMTP ALERTING  (OPTIONAL)
# ============================================================

# SMTP_* variables
# Purpose   : If configured, SecureForge will email simulation reports
#             and critical alerts to the configured address.
# Leave all blank to disable email alerting entirely.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
